// Separate production implementation; closed by config_status. No release in this change.
function "supplier/production/render_confirmation" {
  input {
    json confirmation
  }

  stack {
    api.lambda {
      code = """
        const c=$input.confirmation||{},b=c.booking||{},r=c.request||{},v=c.voucher||{};
        if(b.sandbox!==0||b.status!=='CONFIRMED'||!b.bookingId||!v.code)throw new Error('Confirmed booking and voucher required');
        const e=s=>String(s??'').replace(/[&<>"']/g,x=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[x]));
        const sandbox=Number(b.sandbox)===1;
        const date=s=>/^\d{4}-\d{2}-\d{2}$/.test(s||'')?s.split('-').reverse().join('-'):String(s||'');
        const row=(label,value)=>'<tr><td style="padding:12px 12px;border-bottom:1px solid #e8e8e3;color:#042821;font-weight:bold;width:40%;vertical-align:top;font-size:14px">'+e(label)+'</td><td style="padding:12px 12px;border-bottom:1px solid #e8e8e3;vertical-align:top;font-size:14px;overflow-wrap:anywhere">'+e(value)+'</td></tr>';
        const amount=Number(c.selling_price).toFixed(2).replace('.',',');
        const logo='https://cdn.prod.website-files.com/68cb0d808ea4f2467bb313af/6a48e006585299f4853fe7ea_Nieuw%20logo%20trans-p-500.png';
        const qr='https://api.qrserver.com/v1/create-qr-code/?size=180x180&data='+encodeURIComponent(v.qr_payload||v.code);
        return '<!doctype html><html lang="nl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SeasonDeals boekingsbevestiging</title></head><body style="margin:0;padding:0;background-color:#F7F3ED;color:#1F1F1F;font-family:Arial,Helvetica,sans-serif"><table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" bgcolor="#F7F3ED"><tr><td align="center" style="padding:16px 10px"><table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;border-radius:12px" bgcolor="#ffffff"><tr><td align="center" bgcolor="#ffffff" style="padding:0 16px;background-color:#ffffff;border-radius:12px 12px 0 0"><img src="'+logo+'" width="220" height="220" alt="SeasonDeals — Hot offers, cool prices" style="display:block;width:220px;max-width:100%;height:auto;border:0;margin:0 auto;background-color:#ffffff"></td></tr><tr><td height="4" bgcolor="#F8660B" style="height:4px;line-height:4px;font-size:0">&nbsp;</td></tr><tr><td style="padding:28px 22px">'+(sandbox?'<p style="margin:0 0 18px;padding:10px 12px;background-color:#fff2e9;color:#9a3a00;font-size:13px;font-weight:bold">SANDBOXTEST — geen geldig verblijf</p>':'')+'<h1 style="margin:0 0 20px;font-family:Georgia,serif;font-size:30px;line-height:1.15;font-weight:bold;color:#042821">Uw reservering is bevestigd</h1><p style="font-size:16px;line-height:1.6;margin:0 0 16px">Beste '+e(c.holder?.firstName||'gast')+',</p><p style="font-size:16px;line-height:1.6;margin:0 0 24px">Uw betaling is ontvangen en uw verblijf is bevestigd. Hieronder vindt u uw reserveringsgegevens en uw SeasonDeals-voucher.</p><h2 style="font-family:Georgia,serif;font-size:23px;color:#042821;margin:0 0 12px">Reserveringsgegevens</h2><table width="100%" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse;background-color:#fcfcfc;border:1px solid #e8e8e3">'+row('Hotel',b.hotel?.name||b.hotelName)+row('Aankomst',date(b.checkin||r.checkin))+row('Vertrek',date(b.checkout||r.checkout))+row('Aantal gasten',r.guest_count)+row('Betaald','€ '+amount)+row('Boekingsnummer',b.bookingId)+(b.hotelConfirmationCode?row('Hotelbevestiging',b.hotelConfirmationCode):'')+row('Annulering',(b.cancellationPolicies?.refundableTag||b.tag)==='NRFN'?'Niet-restitueerbaar':'Volgens de bij boeking bevestigde voorwaarden')+'</table><table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:24px 0 20px"><tr><td align="center" bgcolor="#042821" style="padding:20px 12px;background-color:#042821;color:#ffffff;border-radius:8px"><p style="margin:0 0 8px;color:#ffffff;font-size:12px;letter-spacing:1px">UW SEASONDEALS-VOUCHERCODE</p><p style="margin:0;color:#ffffff;font-family:Courier New,monospace;font-size:19px;font-weight:bold;letter-spacing:1px;overflow-wrap:anywhere">'+e(v.code)+'</p></td></tr></table><table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td align="center"><img src="'+qr+'" width="150" height="150" alt="QR-code van uw SeasonDeals-voucher" style="display:block;width:150px;height:150px;border:0"><p style="font-size:12px;line-height:1.5;color:#666;margin:12px 0 24px">QR-code voor de SeasonDeals-administratie.<br>Gebruik bij het hotel uw boekingsnummer en eventuele hotelbevestiging hierboven.</p></td></tr></table><h2 style="font-family:Georgia,serif;font-size:23px;color:#042821;margin:0 0 12px">Bij aankomst</h2><p style="font-size:15px;line-height:1.6;margin:0 0 18px">Uw verblijf is al vastgelegd voor de vermelde data. U hoeft het hotel niet opnieuw te benaderen om deze data te reserveren. Houd deze bevestiging en uw identiteitsbewijs bij de hand.</p><p style="font-size:15px;line-height:1.6;margin:0">Vragen over uw boeking? Mail ons via <a style="color:#042821" href="mailto:klantenservice@seasondeals.nl">klantenservice@seasondeals.nl</a>.</p></td></tr></table><p style="max-width:600px;margin:24px auto 10px;font-size:12px;line-height:1.6;color:#777;text-align:center"><strong>SeasonDeals</strong> — De mooiste hotelervaringen voor elk seizoen.<br><a href="https://www.seasondeals.nl" style="color:#042821">Website</a> &nbsp;|&nbsp; <a href="mailto:klantenservice@seasondeals.nl" style="color:#042821">Klantenservice</a></p></td></tr></table></body></html>';
        """
      timeout = 5
    } as $html
  }

  response = $html
}